{
  "name": "kj-gold-appraiser-backend",
  "version": "1.0.0",
  "description": "KJ Gold Appraiser System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start":         "node src/server.js",
    "dev":           "nodemon src/server.js",
    "start:pm2":     "pm2 start ecosystem.config.js",
    "start:prod":    "pm2 start ecosystem.config.js --env production",
    "reload:prod":   "pm2 reload ecosystem.config.js --env production",
    "stop:pm2":      "pm2 stop kj-gold-api",
    "logs:pm2":      "pm2 logs kj-gold-api",
    "seed":          "node src/utils/seed.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "playwright": "^1.62.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pm2": "^5.4.2"
  }
}
